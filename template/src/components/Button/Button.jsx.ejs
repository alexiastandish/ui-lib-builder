import React from 'react';
import './Button.css'; 

// Default button styles based on the style guide configuration
const defaultStyles = {
  backgroundColor: '<%= styleGuide.colors.primary %>', // Primary color from style guide
  color: '<%= styleGuide.colors.primaryText %>', // Text color from style guide
  padding: '<%= styleGuide.spacing.medium %>', // Medium spacing from style guide
  fontFamily: '<%= styleGuide.typography.fontFamily %>', // Font family from style guide
  fontWeight: '<%= styleGuide.typography.fontWeight.regular %>', // Regular font weight from style guide
  fontSize: '<%= styleGuide.typography.fontSize.base %>', // Base font size from style guide
  borderRadius: '4px',
  border: 'none',
  cursor: 'pointer',
  transition: 'background-color 0.3s ease',
  boxSizing: 'border-box',
  display: 'inline-block',
  textAlign: 'center',
  lineHeight: '1.5',
  minWidth: '120px',
};

// Button Component
const Button = ({ label, onClick, style = {}, className = '', disabled = false }) => {
  const buttonStyles = { ...defaultStyles, ...style, opacity: disabled ? 0.5 : 1, cursor: disabled ? 'not-allowed' : 'pointer' };

  return (
    <button
      style={buttonStyles}
      onClick={onClick}
      className={`button-component ${className}`}
      disabled={disabled}
    >
      {label}
    </button>
  );
};

export default Button;
