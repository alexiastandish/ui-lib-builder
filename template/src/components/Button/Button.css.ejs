.btn {
  font-family: <%= styleGuide.typography.fontFamily %>;
  font-weight: 600;
  border: none;
  border-radius: <%= styleGuide.borderRadius || "4px" %>;
  cursor: pointer;
  padding: 0.5em 1.25em;
  transition: all 0.2s ease-in-out;
}
.btn--primary {
  background-color: <%= styleGuide.colors.primary %>;
  color: <%= styleGuide.colors.white %>;
}
.btn--secondary {
  background-color: <%= styleGuide.colors.secondary %>;
  color: <%= styleGuide.colors.white %>;
}
.btn--small {
  font-size: <%= styleGuide.typography.fontSize.base|| "0.8rem" %>;
}
.btn--medium {
  font-size: <%= styleGuide.typography.fontSize.base || "1rem" %>;
}
.btn--large {
  font-size: <%= styleGuide.typography.fontSize.base || "1.2rem" %>;
}
